{
  "name": "Video Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "video-agent-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "prompt",
              "value": "={{ $json.body.prompt }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Set Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'mistral', prompt: 'Write a 3-minute video script about ' + $json.prompt + '. Split the script into scenes and start each scene with a marker like \"Scene 1:\", \"Scene 2:\", etc. Write only the narration text for each scene.', stream: false }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Script Generation (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b2",
              "name": "script_text",
              "value": "={{ $json.response }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Extract Script",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract scenes from script\nconst script = $('Extract Script').first().json.script_text;\n\n// Split by scene markers\nconst parts = script.split(/Scene\\s*\\d+\\s*:|---/i);\n\n// Drop any intro text the LLM wrote before \"Scene 1:\"\nif (/Scene\\s*\\d+\\s*:/i.test(script) && !/^\\s*Scene\\s*\\d+/i.test(script)) {\n  parts.shift();\n}\n\nconst scenes = parts.map(s => s.trim()).filter(s => s.length > 0);\n\nreturn scenes.map((scene, index) => ({\n  json: {\n    scene_number: index + 1,\n    description: scene.substring(0, 100),\n    full_text: scene,\n    duration_seconds: Math.max(3, Math.ceil(scene.length / 20)),\n    search_query: scene\n      .replace(/[^a-zA-Z\\s]/g, ' ')\n      .split(/\\s+/)\n      .filter(Boolean)\n      .slice(0, 5)\n      .join(' ')\n  }\n}));"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Scene Extractor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Loop Scenes",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "url": "https://api.pexels.com/v1/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "query", "value": "={{ $json.search_query }}" },
            { "name": "per_page", "value": "5" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "YOUR_PEXELS_API_KEY" }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Get Images (Pexels)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 420],
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "scene_number",
              "value": "={{ $('Loop Scenes').item.json.scene_number }}",
              "type": "number"
            },
            {
              "id": "c2",
              "name": "description",
              "value": "={{ $('Loop Scenes').item.json.description }}",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "full_text",
              "value": "={{ $('Loop Scenes').item.json.full_text }}",
              "type": "string"
            },
            {
              "id": "c4",
              "name": "duration_seconds",
              "value": "={{ $('Loop Scenes').item.json.duration_seconds }}",
              "type": "number"
            },
            {
              "id": "c5",
              "name": "image_url",
              "value": "={{ $json.photos && $json.photos.length ? $json.photos[0].src.large : '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Attach Image To Scene",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1560, 420]
    },
    {
      "parameters": {
        "jsCode": "// Collect all processed scenes into one item\nconst scenes = $input.all().map(i => i.json);\n\nreturn [{\n  json: {\n    scenes,\n    image_urls: scenes.map(s => s.image_url).filter(Boolean),\n    script_text: $('Extract Script').first().json.script_text,\n    total_duration: scenes.reduce((sum, s) => sum + s.duration_seconds, 0)\n  }\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Combine Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://texttospeech.googleapis.com/v1/text:synthesize?key=YOUR_API_KEY",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: { text: $json.script_text }, voice: { languageCode: 'en-US', name: 'en-US-Neural2-C' }, audioConfig: { audioEncoding: 'MP3' } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Text To Speech (Google)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 180],
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://python-worker:5000/compose",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ scenes: $('Combine Scenes').first().json.scenes, image_urls: $('Combine Scenes').first().json.image_urls, audio_base64: $json.audioContent }) }}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Compose Video (Python Worker)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 180]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "video_path",
              "value": "={{ $json.video_path }}",
              "type": "string"
            },
            {
              "id": "d2",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Format Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2000, 180]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Respond To Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2220, 180]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Set Prompt", "type": "main", "index": 0 }]]
    },
    "Set Prompt": {
      "main": [[{ "node": "Script Generation (LLM)", "type": "main", "index": 0 }]]
    },
    "Script Generation (LLM)": {
      "main": [[{ "node": "Extract Script", "type": "main", "index": 0 }]]
    },
    "Extract Script": {
      "main": [[{ "node": "Scene Extractor", "type": "main", "index": 0 }]]
    },
    "Scene Extractor": {
      "main": [[{ "node": "Loop Scenes", "type": "main", "index": 0 }]]
    },
    "Loop Scenes": {
      "main": [
        [{ "node": "Combine Scenes", "type": "main", "index": 0 }],
        [{ "node": "Get Images (Pexels)", "type": "main", "index": 0 }]
      ]
    },
    "Get Images (Pexels)": {
      "main": [[{ "node": "Attach Image To Scene", "type": "main", "index": 0 }]]
    },
    "Attach Image To Scene": {
      "main": [[{ "node": "Loop Scenes", "type": "main", "index": 0 }]]
    },
    "Combine Scenes": {
      "main": [[{ "node": "Text To Speech (Google)", "type": "main", "index": 0 }]]
    },
    "Text To Speech (Google)": {
      "main": [[{ "node": "Compose Video (Python Worker)", "type": "main", "index": 0 }]]
    },
    "Compose Video (Python Worker)": {
      "main": [[{ "node": "Format Output", "type": "main", "index": 0 }]]
    },
    "Format Output": {
      "main": [[{ "node": "Respond To Webhook", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "tags": []
}
